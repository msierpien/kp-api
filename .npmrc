# pnpm configuration
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true

# Performance
prefer-frozen-lockfile=true

# Pakiet @msierpien/kp-template-core lezy w GitHub Packages.
#
# Tokena TU NIE MA i byc nie moze - takze jako ${NPM_TOKEN}. pnpm celowo nie
# rozwija zmiennych w danych logowania z pliku commitowanego do repozytorium
# (chroni przed wyciekiem tokenu do obcego rejestru). Token idzie z poziomu
# uzytkownika:
#   lokalnie: ~/.npmrc  (//npm.pkg.github.com/:_authToken=ghp_...)
#   Vercel:   Install Command dopisuje go przed instalacja (patrz README)
#   Docker:   sekret montowany jako /root/.npmrc (patrz Dockerfile)
@msierpien:registry=https://npm.pkg.github.com
